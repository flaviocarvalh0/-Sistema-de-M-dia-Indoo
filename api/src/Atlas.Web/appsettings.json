{
  "Jwt": {
    "Issuer": "Atlas",
    "Audience": "Atlas.Clients",
    "AccessTokenMinutes": 30
  },
  "PlatformSettings": {
    "ForceLocalTimeZone": true,
    "DefaultTimeZoneId": "E. South America Standard Time"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Indoor": {
    "UrlPainel": "http://localhost:4200",
    "Armazenamento": {
      "Supabase": {
        "Url": "",
        "Bucket": "midias",
        "CriarBucket": true
      }
    }
  },
  "AllowedHosts": "*"
}