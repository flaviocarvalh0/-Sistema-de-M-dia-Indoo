<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuração do IIS para o SPA.

  Mora em `public/` porque o `angular.json` copia `public/**/*` para a raiz da
  saída do build. Assim o arquivo viaja junto com o `dist` e não depende de
  alguém lembrar de colocá-lo no servidor.
-->
<configuration>

  <!--
    `inheritInChildApplications="false"` é obrigatório, não cosmético.

    Em produção a API é uma aplicação FILHA deste site (`/backend`). Sem esta
    marca, o IIS herda a regra de rewrite abaixo dentro dela e todo caminho da
    API que não corresponda a um arquivo em disco — ou seja, TODOS, porque são
    rotas — é reescrito para o `index.html`. A API passa a devolver a página do
    front com status 200, e o front quebra tentando ler HTML como JSON.
  -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!--
        Roteamento do Angular: o servidor não conhece `/cliente-monitorado`.
        Sem esta regra, abrir a URL direta ou dar F5 numa rota interna devolve
        404 — a navegação por dentro do app funciona, e só o acesso direto
        falha, que é o que faz o problema passar despercebido em teste.
      -->
      <rewrite>
        <rules>
          <rule name="Angular SPA" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
              <!-- Arquivo ou pasta que existe é servido como está. -->
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
              <!--
                Cinto de segurança além do `inheritInChildApplications`: mesmo
                que a herança seja reativada por engano, a API não é engolida.
              -->
              <add input="{REQUEST_URI}" pattern="^/(backend|api)/" negate="true" />
            </conditions>
            <!--
              URL RELATIVA, sem a barra inicial. O URL Rewrite resolve o
              destino a partir da pasta deste web.config, entao a MESMA regra
              serve o app na raiz do site e numa subpasta (/midia-indoor-web). Com
              "/index.html" ele sempre apontaria para a raiz do site, e numa
              subpasta devolveria o app errado — ou 404.
            -->
            <action type="Rewrite" url="index.html" />
          </rule>
        </rules>
      </rewrite>

      <defaultDocument>
        <files>
          <clear />
          <add value="index.html" />
        </files>
      </defaultDocument>

      <staticContent>
        <!--
          `outputHashing: all` põe o hash do conteúdo no nome de cada chunk, e
          nome novo a cada build significa que o arquivo antigo nunca é
          reaproveitado indevidamente. Pode cachear para sempre.

          O `index.html` é a exceção e está tratado no bloco abaixo.
        -->
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />

        <!-- O `remove` antes de cada `add` evita erro 500.19 se o tipo já
             estiver registrado na máquina. -->
        <remove fileExtension=".json" />
        <mimeMap fileExtension=".json" mimeType="application/json" />
        <remove fileExtension=".woff2" />
        <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        <remove fileExtension=".woff" />
        <mimeMap fileExtension=".woff" mimeType="font/woff" />
        <remove fileExtension=".webmanifest" />
        <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      </staticContent>

      <httpCompression>
        <staticTypes>
          <add mimeType="text/*" enabled="true" />
          <add mimeType="application/javascript" enabled="true" />
          <add mimeType="application/json" enabled="true" />
          <add mimeType="image/svg+xml" enabled="true" />
          <add mimeType="*/*" enabled="false" />
        </staticTypes>
      </httpCompression>

      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>

    </system.webServer>
  </location>

  <!--
    O `index.html` NÃO pode ser cacheado: ele é o único arquivo com nome fixo, e
    é ele que aponta para os chunks com hash. Cacheado, o navegador continua
    pedindo os chunks da versão anterior depois de um deploy — que já não
    existem no servidor — e o app abre em tela branca com 404 no console.
  -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!--
    `assets/config.json` carrega o endereço da API e é EDITADO NO SERVIDOR.
    Cacheado por um ano como o resto do estático, trocar o endereço não teria
    efeito nenhum até alguém limpar o cache do navegador — e o sintoma seria
    "a API está no ar mas ninguém loga".

    O `main.ts` também pede com `cache: 'no-store'` e carimbo na query. Os dois
    juntos porque um cobre o navegador e o outro cobre proxy no caminho.
  -->
  <!--
    O service worker dos avisos do pedido (D-26) tem nome fixo como o
    `index.html`: cacheado, uma correção nele demoraria a chegar aos celulares.
  -->
  <location path="push-sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="assets/config.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
