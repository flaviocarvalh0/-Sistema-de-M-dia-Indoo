{
  "name": "midia-indoor-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "publicar": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publicar-iis.ps1",
    "publicar:fw": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publicar-iis.ps1 -ComFramework",
    "test": "ng test",
    "prestart": "node scripts/gerar-versao.js",
    "prebuild": "node scripts/gerar-versao.js",
    "versao": "node scripts/gerar-versao.js",
    "versao:patch": "npm version patch --no-git-tag-version && node scripts/gerar-versao.js",
    "versao:minor": "npm version minor --no-git-tag-version && node scripts/gerar-versao.js",
    "versao:major": "npm version major --no-git-tag-version && node scripts/gerar-versao.js"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@atlas/framework": "file:../../atlas-framework/dist/atlas/framework",
    "angularx-qrcode": "^21.0.5",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "ngx-mask": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
